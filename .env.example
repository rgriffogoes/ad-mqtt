# Copy to .env for local runs (run.py loads it automatically).
# Real environment variables take precedence over values set here.

# Alarm Decoder ser2sock server location
ADMQTT_SOCKET_HOST=127.0.0.1
ADMQTT_SOCKET_PORT=10000
# Set to True to reset all zones to closed (not faulted) on startup
ADMQTT_RESTORE_ON_STARTUP=False

# Local JSON-lines log of RF messages, known and unknown serials (helps map
# new RF devices and debug loop mapping). Leave empty to disable; the file
# rotates at the size cap.
ADMQTT_RF_LOG_FILE=rf_log.jsonl
ADMQTT_RF_LOG_MAX_MB=100

# MQTT Broker connection
ADMQTT_MQTT_HOST=127.0.0.1
ADMQTT_MQTT_PORT=1883
# Optional user/pass for the broker
ADMQTT_MQTT_USERNAME=
ADMQTT_MQTT_PASSWORD=
# Optional encryption settings for the broker
ADMQTT_MQTT_CA_CERT=
ADMQTT_MQTT_CERTFILE=
ADMQTT_MQTT_KEYFILE=

# Debugging information
ADMQTT_LOG_LEVEL=INFO
# Log to the console (default True)
ADMQTT_LOG_SCREEN=True
# File logging is opt-in: leave empty for console-only (default),
# or set a path (e.g. log.txt) to also write a rotating log file.
ADMQTT_LOG_FILE=

# Alarm panel code
ADMQTT_ALARM_CODE=1234
